---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Contact | Dr. Felipe F. Tapia" lang="en">
	<main class="max-w-4xl mx-auto px-6 py-14">
		<header class="mb-10">
			<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-xs font-semibold uppercase tracking-wider mb-3">
				Contact & Academic Inquiries
			</div>
			<h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white font-display mb-4">
				Contact
			</h1>
			<p class="text-lg text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
				For academic research inquiries, thesis supervision, scientific collaborations, or professional consulting services in structural geology and numerical/analog modeling.
			</p>
		</header>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
			<!-- Contact Card -->
			<div class="md:col-span-2 p-8 border border-slate-200 dark:border-slate-800 rounded-2xl bg-white dark:bg-slate-900/60 shadow-sm space-y-6">
				<div class="space-y-6">
					<div class="flex items-start gap-4">
						<div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 flex items-center justify-center flex-shrink-0 mt-0.5">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
						</div>
						<div>
							<h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Email Address</h3>
							<a href="mailto:ftapia@gl.fcen.uba.ar" class="text-lg font-semibold text-blue-600 dark:text-blue-400 hover:underline">
								ftapia@gl.fcen.uba.ar
							</a>
						</div>
					</div>

					<div class="flex items-start gap-4">
						<div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center flex-shrink-0 mt-0.5">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
						</div>
						<div>
							<h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Laboratory & Department</h3>
							<p class="text-slate-800 dark:text-slate-200 font-medium">
								<a href="http://157.92.29.231/es/" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-blue-400 underline decoration-slate-300 dark:decoration-slate-700 underline-offset-4">
									Geological Modeling Laboratory (LaMoGe)
								</a>
							</p>
							<p class="text-slate-600 dark:text-slate-400 text-sm mt-1">
								<a href="http://www.idean.gl.fcen.uba.ar/quienes-somos/" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-blue-400 underline decoration-slate-300 dark:decoration-slate-700 underline-offset-4">
									Institute of Andean Studies "Don Pablo Groeber" (IDEAN, UBA - CONICET)
								</a>
							</p>
						</div>
					</div>

					<div class="flex items-start gap-4">
						<div class="w-10 h-10 rounded-xl bg-purple-100 dark:bg-purple-900/40 text-purple-600 dark:text-purple-400 flex items-center justify-center flex-shrink-0 mt-0.5">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
						</div>
						<div>
							<h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Office Location</h3>
							<p class="text-slate-700 dark:text-slate-300 text-sm">
								Pabellón 2, Ciudad Universitaria, C1428EHA<br/>
								Autonomous City of Buenos Aires, Argentina.
							</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Links & Networks -->
			<div class="space-y-4">
				<div class="p-6 border border-slate-200 dark:border-slate-800 rounded-2xl bg-white dark:bg-slate-900/60 shadow-sm space-y-4">
					<h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider">Academic Profiles</h3>
					<div class="space-y-2 text-sm">
						<a href="https://github.com/flapia" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 group">
							<span>GitHub</span>
							<span class="text-blue-600 dark:text-blue-400 group-hover:translate-x-0.5 transition-transform">&rarr;</span>
						</a>
						<a href="https://scholar.google.com/citations?user=rF_4EDcAAAAJ&hl=es" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 group">
							<span>Google Scholar</span>
							<span class="text-blue-600 dark:text-blue-400 group-hover:translate-x-0.5 transition-transform">&rarr;</span>
						</a>
						<a href="https://www.researchgate.net/profile/Felipe-Tapia-4?ev=hdr_xprf&_tp=eyJjb250ZXh0Ijp7ImZpcnN0UGFnZSI6ImhvbWUiLCJwYWdlIjoiaG9tZSIsInByZXZpb3VzUGFnZSI6InByb2ZpbGUiLCJwb3NpdGlvbiI6Imdsb2JhbEhlYWRlciJ9fQ" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 group">
							<span>ResearchGate</span>
							<span class="text-blue-600 dark:text-blue-400 group-hover:translate-x-0.5 transition-transform">&rarr;</span>
						</a>
						<a href="https://orcid.org/0000-0002-5397-3071" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 group">
							<span>ORCID</span>
							<span class="text-blue-600 dark:text-blue-400 group-hover:translate-x-0.5 transition-transform">&rarr;</span>
						</a>
					</div>
				</div>

				<div class="p-6 border border-slate-200 dark:border-slate-800 rounded-2xl bg-white dark:bg-slate-900/60 shadow-sm space-y-3">
					<h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider">Institutional Websites</h3>
					<div class="space-y-2 text-sm">
						<a href="http://157.92.29.231/es/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 group">
							<span>LaMoGe Lab Website</span>
							<span class="text-emerald-600 dark:text-emerald-400 group-hover:translate-x-0.5 transition-transform">&rarr;</span>
						</a>
						<a href="http://www.idean.gl.fcen.uba.ar/quienes-somos/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 group">
							<span>IDEAN (CONICET/UBA) Website</span>
							<span class="text-emerald-600 dark:text-emerald-400 group-hover:translate-x-0.5 transition-transform">&rarr;</span>
						</a>
					</div>
				</div>
			</div>
		</div>
	</main>
</Layout>
