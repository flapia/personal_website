---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const specializations = [
	{
		title: "Andean Tectonics & Structural Modeling",
		desc: "Fold-and-thrust belts, fault kinematic analysis, natural fracture characterization, and crustal-scale tectonic evolution throughout the Central and Fuegian Andes.",
		img: `${base}/images/andean_tectonics.jpg`,
		alt: "Andean structural fold and thrust belt outcrop",
		tag: "Tectonics & Faults",
		color: "blue"
	},
	{
		title: "Basin & Subsurface Analysis",
		desc: "Rift systems and foreland sedimentary basins. Integration of borehole data and 2D/3D seismic interpretation applied to conventional and unconventional reservoirs.",
		img: `${base}/images/basin_subsurface.jpg`,
		alt: "3D seismic cube visualization and rift basin analysis",
		tag: "Subsurface & Seismic",
		color: "emerald"
	},
	{
		title: "UAV Photogrammetry & 3D Models",
		desc: "Drone surveys and rock mass geomechanical characterization. 3D digital outcrop modeling (DOM) and high-density point cloud structural orientation extraction.",
		img: `${base}/images/uav_photogrammetry.jpg`,
		alt: "UAV drone surveying steep outcrop and generating 3D DOM",
		tag: "Drones & DOM",
		color: "purple"
	},
	{
		title: "Computational Geology & Modeling",
		desc: "Physical sandbox analog modeling, mechanical numerical models, and Python/QGIS computational workflows for quantitative geosciences and university training.",
		img: `${base}/images/computational_modeling.jpg`,
		alt: "Sandbox apparatus and numerical finite element simulation screens",
		tag: "Sandboxes & Python",
		color: "amber"
	}
];
---

<Layout title="Dr. Felipe F. Tapia | Structural Geologist & Researcher" lang="en">
	<main class="w-full">
		<!-- Hero Section -->
		<section class="relative w-full overflow-hidden bg-slate-950 text-white border-b border-slate-800">
			<!-- Background banner image with subtle parallax feel & dark gradients -->
			<div class="absolute inset-0 z-0 opacity-25 mix-blend-luminosity filter contrast-125">
				<img 
					src={`${base}/images/hero_banner.jpg`} 
					alt="Andes Geological Fold & Thrust Belt" 
					class="w-full h-full object-cover object-center"
				/>
			</div>
			<div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/90 to-slate-950/80 z-0"></div>
			<div class="absolute top-10 right-10 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl animate-blob pointer-events-none"></div>
			<div class="absolute bottom-10 left-10 w-96 h-96 bg-emerald-600/15 rounded-full blur-3xl animate-blob animation-delay-2000 pointer-events-none"></div>

			<div class="max-w-6xl mx-auto px-6 py-20 md:py-28 relative z-10">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
					
					<!-- Left Column: Profile & Main Bio -->
					<div class="lg:col-span-7 flex flex-col sm:flex-row gap-8 items-center sm:items-start text-center sm:text-left">
						<!-- Profile picture -->
						<div class="relative group flex-shrink-0">
							<div class="absolute -inset-1.5 bg-gradient-to-r from-blue-600 to-emerald-600 rounded-full blur opacity-60 group-hover:opacity-100 transition duration-500"></div>
							<div class="relative w-44 h-44 md:w-48 md:h-48 rounded-full overflow-hidden border-4 border-slate-900 shadow-2xl bg-slate-800">
								<img 
									src={`${base}/profile.jpg`} 
									alt="Dr. Felipe F. Tapia" 
									class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
									onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
								/>
								<div class="hidden w-full h-full bg-slate-800 items-center justify-center text-slate-300 font-display font-bold text-5xl">
									FT
								</div>
							</div>
						</div>

						<div class="space-y-4">
							<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/15 border border-blue-400/30 text-blue-300 text-xs font-semibold tracking-wide uppercase">
								CONICET &bull; IDEAN &bull; UBA
							</div>
							<h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-extrabold tracking-tight text-white drop-shadow-sm">
								Dr. Felipe F. Tapia
							</h1>
							<h2 class="text-lg md:text-xl text-blue-200 font-display font-medium">
								Structural Geologist &bull; CONICET Researcher
							</h2>
							<p class="text-slate-300 text-sm md:text-base leading-relaxed">
								Assistant Researcher at the Geological Modeling Laboratory (LaMoGe), IDEAN (CONICET - University of Buenos Aires) and Head of Practical Assignments at FCEN-UBA. Specializing in Andean tectonics, analog and numerical modeling, and basin analysis for energetic and scientific exploration.
							</p>
							
							<div class="flex flex-wrap justify-center sm:justify-start gap-3 pt-2">
								<a 
									href={`${base}/CV-may_2026%20(1).pdf`} 
									target="_blank" 
									class="px-5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium text-sm rounded-xl shadow-lg shadow-blue-600/30 transition-all duration-300 flex items-center gap-2"
								>
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
									Academic CV
								</a>
								<a 
									href={`${base}/Tapia_Felipe_CV.pdf`} 
									target="_blank" 
									class="px-5 py-2.5 bg-white/10 hover:bg-white/20 text-white backdrop-blur-md border border-white/20 font-medium text-sm rounded-xl transition-all duration-300 flex items-center gap-2"
								>
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
									Industry CV
								</a>
								<a 
									href={`${base}/en/contact`} 
									class="px-5 py-2.5 bg-slate-800/80 hover:bg-slate-700 text-slate-200 border border-slate-700 font-medium text-sm rounded-xl transition-all duration-300"
								>
									Contact Me
								</a>
							</div>
						</div>
					</div>

					<!-- Right Column: Geological Overview Showcase Card -->
					<div class="lg:col-span-5 relative group">
						<div class="absolute -inset-1 bg-gradient-to-r from-blue-600 via-indigo-600 to-emerald-600 rounded-2xl blur-lg opacity-40 group-hover:opacity-75 transition duration-500"></div>
						<div class="relative rounded-2xl overflow-hidden border border-slate-800 bg-slate-900/90 backdrop-blur-md shadow-2xl">
							<div class="relative h-56 sm:h-64 overflow-hidden">
								<img 
									src={`${base}/images/hero_banner.jpg`} 
									alt="Andean Tectonics & Structural Geology" 
									class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
								/>
								<div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent"></div>
								<div class="absolute top-3 right-3 px-2.5 py-1 rounded-full bg-slate-950/80 border border-white/20 text-xs font-semibold text-emerald-400 backdrop-blur-md">
									Field & Research
								</div>
							</div>
							<div class="p-5 space-y-2">
								<h3 class="font-display font-bold text-lg text-white">
									Structural Geology & Quantitative Modeling
								</h3>
								<p class="text-xs text-slate-300 leading-relaxed">
									Integrating field observations across the Andes with physical sandbox models, numerical mechanical simulations, and high-resolution 3D photogrammetry.
								</p>
							</div>
						</div>
					</div>

				</div>
			</div>
		</section>

		<!-- Areas of Expertise -->
		<section class="py-20 bg-slate-50 dark:bg-slate-950 transition-colors">
			<div class="max-w-6xl mx-auto px-6">
				<div class="text-center max-w-2xl mx-auto mb-16">
					<h3 class="text-xs font-bold tracking-widest text-blue-600 dark:text-blue-400 uppercase mb-2">Research & Work</h3>
					<h2 class="text-3xl md:text-4xl font-display font-bold text-slate-900 dark:text-white">
						Areas of Expertise & Interests
					</h2>
					<div class="w-16 h-1 bg-gradient-to-r from-blue-600 to-emerald-500 mx-auto mt-4 rounded-full"></div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
					{specializations.map(item => (
						<article class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 shadow-sm hover:shadow-2xl transition-all duration-300 overflow-hidden flex flex-col justify-between group">
							<div class="p-6 md:p-8 space-y-4">
								<div class="flex items-center justify-between gap-3">
									<span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
										{item.tag}
									</span>
								</div>
								<h3 class="font-display font-bold text-xl text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
									{item.title}
								</h3>
								<p class="text-slate-600 dark:text-slate-300 leading-relaxed text-sm md:text-base">
									{item.desc}
								</p>
							</div>

							<!-- Image below description -->
							<div class="relative w-full h-52 sm:h-60 overflow-hidden bg-slate-100 dark:bg-slate-800 border-t border-slate-100 dark:border-slate-800/80">
								<img 
									src={item.img} 
									alt={item.alt} 
									class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
									loading="lazy"
								/>
								<div class="absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-transparent pointer-events-none"></div>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>
	</main>
</Layout>
