---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const allProjects = await getCollection('projects');
const academicProjects = allProjects.filter(p => p.data.category === 'Academic').sort((a,b) => b.data.year.localeCompare(a.data.year));
const industryProjects = allProjects.filter(p => p.data.category === 'Industry').sort((a,b) => b.data.year.localeCompare(a.data.year));

// STAN / Industry services are temporarily hidden from public view pending user verification
const showIndustryProjects = false;
---
<Layout title="Projects | Dr. Felipe F. Tapia" lang="en">
	<main class="max-w-4xl mx-auto px-6 py-12">
		<h1 class="text-4xl font-bold mb-4 text-slate-800 dark:text-white font-display">Projects & Grants</h1>
		<p class="text-slate-600 dark:text-slate-300 text-lg mb-8 leading-relaxed">
			Scientific research projects funded by national agencies (FONDECYT, ANPCyT / PICT) and inter-institutional collaboration agreements.
		</p>
		
		<h2 class="text-2xl font-semibold mb-6 mt-10 text-blue-700 dark:text-blue-400 font-display">Academic Research Grants</h2>
		<div class="grid grid-cols-1 gap-6">
			{academicProjects.map(project => (
				<article class="p-6 border border-slate-200 dark:border-slate-800 rounded-xl bg-white dark:bg-slate-900/50 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
					<h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3 leading-snug">
						{project.data.title}
					</h3>
					{project.data.description && (
						<p class="text-sm text-slate-600 dark:text-slate-400 mb-3 leading-relaxed">
							{project.data.description}
						</p>
					)}
					<div class="flex flex-wrap items-center gap-3 text-sm">
						<span class="px-2 py-1 bg-blue-100 dark:bg-blue-900/50 text-blue-800 dark:text-blue-300 rounded font-medium">{project.data.role}</span>
						<span class="text-slate-500 font-medium">{project.data.year}</span>
						<span class="text-slate-300 dark:text-slate-700">&bull;</span>
						<span class="text-slate-500">{project.data.location}</span>
					</div>
				</article>
			))}
		</div>

		{showIndustryProjects && (
			<section class="mt-16">
				<h2 class="text-2xl font-semibold mb-6 text-emerald-700 dark:text-emerald-400 font-display">
					Industry Consulting & High-Level Technical Services (STAN)
				</h2>
				<div class="grid grid-cols-1 gap-6">
					{industryProjects.map(project => (
						<article class="group p-6 border border-slate-200 dark:border-slate-800 rounded-xl bg-white dark:bg-slate-900/50 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
							<h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-2 leading-snug">
								{project.data.title}
							</h3>
							
							<!-- Description with card styling and hover accent -->
							<div class="my-2.5">
								<p class="text-sm text-slate-600 dark:text-slate-300 bg-slate-50 dark:bg-slate-800/60 p-3 rounded-lg border border-slate-200/70 dark:border-slate-700/50 group-hover:border-emerald-500/50 transition-colors">
									{project.data.description || project.body || "Structural geological assessment, kinematic modeling and interpretation for basin exploration."}
								</p>
							</div>

							<div class="flex flex-wrap items-center gap-3 text-sm pt-1">
								<span class="px-2 py-1 bg-emerald-100 dark:bg-emerald-900/50 text-emerald-800 dark:text-emerald-300 rounded font-medium">{project.data.role}</span>
								<span class="text-slate-500 font-medium">{project.data.year}</span>
								<span class="text-slate-300 dark:text-slate-700">&bull;</span>
								<span class="text-slate-500">{project.data.location}</span>
							</div>
						</article>
					))}
				</div>
			</section>
		)}
	</main>
</Layout>
