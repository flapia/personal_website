---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const allProjects = await getCollection('projects');
const academicProjects = allProjects.filter(p => p.data.category === 'Academic').sort((a,b) => b.data.year.localeCompare(a.data.year));
const industryProjects = allProjects.filter(p => p.data.category === 'Industry').sort((a,b) => b.data.year.localeCompare(a.data.year));
---
<Layout title="Projects | Dr. Felipe F. Tapia" lang="en">
	<main class="max-w-4xl mx-auto px-6 py-12">
		<h1 class="text-4xl font-bold mb-8 text-slate-800 dark:text-white">Projects & Consulting</h1>
		
		<h2 class="text-2xl font-semibold mb-6 mt-12 text-blue-700 dark:text-blue-400">Academic Research Grants</h2>
		<div class="grid grid-cols-1 gap-6">
			{academicProjects.map(project => (
				<article class="p-6 border border-slate-200 dark:border-slate-800 rounded-xl bg-white dark:bg-slate-900/50 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
					<h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3 leading-snug">
						{project.data.title}
					</h3>
					<div class="flex flex-wrap items-center gap-3 text-sm">
						<span class="px-2 py-1 bg-blue-100 dark:bg-blue-900/50 text-blue-800 dark:text-blue-300 rounded font-medium">{project.data.role}</span>
						<span class="text-slate-500 font-medium">{project.data.year}</span>
						<span class="text-slate-300 dark:text-slate-700">&bull;</span>
						<span class="text-slate-500">{project.data.location}</span>
					</div>
				</article>
			))}
		</div>

		<h2 class="text-2xl font-semibold mb-6 mt-16 text-emerald-700 dark:text-emerald-400">Industry & Technical Services (STAN)</h2>
		<div class="grid grid-cols-1 gap-6">
			{industryProjects.map(project => (
				<article class="p-6 border border-slate-200 dark:border-slate-800 rounded-xl bg-white dark:bg-slate-900/50 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
					<h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3 leading-snug">
						{project.data.title}
					</h3>
					<div class="flex flex-wrap items-center gap-3 text-sm">
						<span class="px-2 py-1 bg-emerald-100 dark:bg-emerald-900/50 text-emerald-800 dark:text-emerald-300 rounded font-medium">{project.data.role}</span>
						<span class="text-slate-500 font-medium">{project.data.year}</span>
						<span class="text-slate-300 dark:text-slate-700">&bull;</span>
						<span class="text-slate-500">{project.data.location}</span>
					</div>
				</article>
			))}
		</div>
	</main>
</Layout>
