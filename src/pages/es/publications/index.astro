---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const allPapers = await getCollection('papers');
const papers = allPapers.sort((a, b) => b.data.year - a.data.year);
---
<Layout title="Publicaciones | Dr. Felipe F. Tapia" lang="es">
	<main class="max-w-4xl mx-auto px-6 py-12">
		<h1 class="text-4xl font-bold mb-8 text-slate-800 dark:text-white">Publicaciones</h1>
		<div class="grid grid-cols-1 gap-6">
			{papers.map(paper => (
				<article class="p-6 border border-slate-200 dark:border-slate-800 rounded-xl bg-white dark:bg-slate-900/50 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
					<div class="flex items-start justify-between gap-4">
						<div>
							<h2 class="text-xl font-semibold text-slate-900 dark:text-white mb-2">
								{paper.data.title}
							</h2>
							<p class="text-slate-600 dark:text-slate-300 mb-2">
								{paper.data.authors.join(', ')}
							</p>
							<div class="flex items-center gap-3 text-sm">
								<span class="px-2 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded font-medium">
									{paper.data.journal}
								</span>
								<span class="text-slate-500">{paper.data.year}</span>
							</div>
						</div>
					</div>
				</article>
			))}
		</div>
	</main>
</Layout>
