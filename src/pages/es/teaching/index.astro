---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const allTeaching = await getCollection('teaching');
const courses = allTeaching.filter(t => t.data.category === 'Course');
const mentorships = allTeaching.filter(t => t.data.category === 'Mentorship');

// Parse year helper
function getYearNumber(yearStr: string): number {
	const match = yearStr.match(/\d{4}/);
	return match ? parseInt(match[0], 10) : 0;
}

// In-progress theses (Facundo Lorenzo, Agustina Menschik, Ernesto Arevalo, plus doctoral thesis)
const inProgressMentorships = mentorships
	.filter(t => t.data.year.includes('En curso') || t.data.year.includes('In progress'))
	.sort((a, b) => getYearNumber(b.data.year) - getYearNumber(a.data.year));

// Completed theses sorted by year descending
const completedMentorships = mentorships
	.filter(t => !t.data.year.includes('En curso') && !t.data.year.includes('In progress'))
	.sort((a, b) => getYearNumber(b.data.year) - getYearNumber(a.data.year));
---

<Layout title="Docencia y Formación | Dr. Felipe F. Tapia" lang="es">
	<main class="max-w-4xl mx-auto px-6 py-12">
		<h1 class="text-4xl font-bold mb-8 text-slate-800 dark:text-white">Docencia y Formación</h1>
		
		<h2 class="text-2xl font-semibold mb-6 mt-12 text-blue-700 dark:text-blue-400">Cargos Docentes Universitarios</h2>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			{courses.map(course => (
				<article class="p-6 border border-slate-200 dark:border-slate-800 rounded-xl bg-white dark:bg-slate-900/50 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between">
					<div>
						<h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3 leading-snug">
							{course.data.title}
						</h3>
						<p class="text-slate-600 dark:text-slate-400 mb-4">{course.data.role} en {course.data.institution}</p>
					</div>
					<div class="flex items-center justify-between text-sm text-slate-500">
						<span class="font-medium">{course.data.year}</span>
						{course.data.link && (
							<a href={course.data.link} target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1">
								Ver material <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" /><path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" /></svg>
							</a>
						)}
					</div>
				</article>
			))}
		</div>

		<h2 class="text-2xl font-semibold mb-6 mt-16 text-emerald-700 dark:text-emerald-400">Formación de Recursos Humanos</h2>
		
		<!-- En curso -->
		<div class="mb-10">
			<h3 class="text-lg font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-4 flex items-center gap-2">
				<span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
				Tesis en Curso
			</h3>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				{inProgressMentorships.map(mentorship => (
					<article class="p-6 border border-amber-200 dark:border-amber-900/40 rounded-xl bg-amber-50/30 dark:bg-slate-900/50 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
						<div class="flex items-start justify-between gap-2 mb-2">
							<h4 class="text-lg font-semibold text-slate-900 dark:text-white leading-snug">
								{mentorship.data.title}
							</h4>
							<span class="px-2 py-0.5 text-xs font-semibold rounded bg-amber-100 dark:bg-amber-900/40 text-amber-800 dark:text-amber-300 whitespace-nowrap">
								En curso
							</span>
						</div>
						<p class="text-slate-600 dark:text-slate-400 mb-3 text-sm">Rol: <span class="font-medium text-slate-800 dark:text-slate-200">{mentorship.data.role}</span> &bull; {mentorship.data.institution}</p>
						<div class="text-sm text-slate-500">
							<span>{mentorship.data.year}</span>
						</div>
					</article>
				))}
			</div>
		</div>

		<!-- Finalizados -->
		<div>
			<h3 class="text-lg font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-4 flex items-center gap-2">
				<span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
				Tesis Finalizadas
			</h3>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				{completedMentorships.map(mentorship => (
					<article class="p-6 border border-slate-200 dark:border-slate-800 rounded-xl bg-white dark:bg-slate-900/50 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
						<div class="flex items-start justify-between gap-2 mb-2">
							<h4 class="text-lg font-semibold text-slate-900 dark:text-white leading-snug">
								{mentorship.data.title}
							</h4>
							<span class="px-2 py-0.5 text-xs font-semibold rounded bg-emerald-100 dark:bg-emerald-900/30 text-emerald-800 dark:text-emerald-300 whitespace-nowrap">
								Finalizado
							</span>
						</div>
						<p class="text-slate-600 dark:text-slate-400 mb-3 text-sm">Rol: <span class="font-medium text-slate-800 dark:text-slate-200">{mentorship.data.role}</span> &bull; {mentorship.data.institution}</p>
						<div class="text-sm text-slate-500">
							<span>{mentorship.data.year}</span>
						</div>
					</article>
				))}
			</div>
		</div>
	</main>
</Layout>
