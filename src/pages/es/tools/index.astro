---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const tools = await getCollection('tools');
---

<Layout title="Herramientas y Software | Dr. Felipe F. Tapia" lang="es">
	<main class="max-w-5xl mx-auto px-6 py-14">
		<header class="mb-12">
			<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-xs font-semibold uppercase tracking-wider mb-4">
				Geología Computacional & Metodologías
			</div>
			<h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white font-display mb-4">
				Herramientas, Software y Recursos
			</h1>
			<p class="text-lg text-slate-600 dark:text-slate-300 max-w-3xl leading-relaxed">
				Recursos de código abierto, cuadernos interactivos y metodologías de modelado analógico y numérico desarrollados para investigación y docencia.
			</p>
		</header>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
			{tools.map(tool => (
				<article class="p-8 border border-slate-200 dark:border-slate-800 rounded-2xl bg-white dark:bg-slate-900/60 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between">
					<div>
						<div class="flex items-center justify-between mb-4">
							<div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 text-white flex items-center justify-center shadow-md">
								<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
								</svg>
							</div>
							<div class="flex items-center gap-2">
								{tool.data.githubUrl && (
									<a href={tool.data.githubUrl} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors" title="Código en GitHub">
										<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
											<path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
										</svg>
									</a>
								)}
								{tool.data.colabUrl && (
									<a href={tool.data.colabUrl} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors" title="Página / Recursos">
										<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
										</svg>
									</a>
								)}
							</div>
						</div>

						<h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-3">
							{tool.data.title_es || tool.data.title}
						</h2>
						<p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
							{tool.data.description_es || tool.data.description}
						</p>
					</div>

					<div>
						<div class="flex flex-wrap gap-2 pt-4 border-t border-slate-100 dark:border-slate-800">
							{tool.data.tech.map(techItem => (
								<span class="px-2.5 py-1 text-xs font-medium rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
									{techItem}
								</span>
							))}
						</div>
					</div>
				</article>
			))}
		</div>
	</main>
</Layout>
